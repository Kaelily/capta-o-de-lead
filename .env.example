# =======================================================
# AzurraERP - Configurações do Banco Microsoft SQL Server
# =======================================================

# Endereço do Servidor SQL Server (ex: localhost, 127.0.0.1 ou nome da instância)
DB_SERVER=localhost

# Porta padrão do SQL Server (padrão: 1433)
DB_PORT=1433

# Nome da Base de Dados
DB_DATABASE=azurra_leads

# Usuário do SQL Server (ex: sa)
DB_USER=sa

# Senha do usuário do SQL Server
DB_PASSWORD=SuaSenhaForteAqui123!

# Opções de Criptografia SSL/TLS (Para servidores locais/desenvolvimento mantenha false)
DB_ENCRYPT=false

# Aceitar certificados autoassinados (Recomendado true em desenvolvimento ou servidores locais)
DB_TRUST_SERVER_CERT=true

# Porta do Servidor Web da API
PORT=3000
